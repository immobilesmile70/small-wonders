rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profile document: strictly read-only for the authenticated owner.
    // All mutations must pass through the Vercel Serverless API using Firebase Admin SDK.
    match /users/{uid} {
      allow get, list: if isOwner(uid);
      allow create, update, delete: if false;

      // Journal entry subcollection: strictly read-only for the authenticated owner.
      // Enforces bounded query limits on list operations (max 50 documents per read).
      match /entries/{entryId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid)
                    && (request.query.limit == null || request.query.limit <= 50);
        allow create, update, delete: if false;
      }
    }

    // Default deny for all other paths in the database.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
