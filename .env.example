# ==============================================================================
# SMALL WONDERS - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit real secrets, service account private keys, or Redis tokens.
#
# Variables prefixed with `VITE_` are exposed to the browser bundle.
# Variables WITHOUT `VITE_` are strictly server-only (Vercel Serverless Functions).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT CONFIGURATION (Browser-visible via Vite)
# ------------------------------------------------------------------------------
# Firebase Web App Config (Safe to expose; security is enforced by Firestore Rules & Admin API)
VITE_FIREBASE_API_KEY="AIzaSy_PLACEHOLDER_REPLACE_WITH_YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:placeholder000000"

# Optional: Firebase App Check (reCAPTCHA Enterprise Site Key)
VITE_FIREBASE_APPCHECK_SITE_KEY="6Lc_PLACEHOLDER_RECAPTCHA_ENTERPRISE_SITE_KEY"
VITE_ENABLE_APP_CHECK="false"

# Optional: Local Firebase Emulator toggle ("true" or "false")
VITE_USE_FIREBASE_EMULATORS="false"
VITE_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
VITE_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Organization / Deployment Contact Metadata (Displayed on Legal & Accessibility pages)
# Do not invent fake business addresses; configure your real deployment contact details here.
VITE_PUBLIC_CONTACT_EMAIL="contact@example.invalid"
VITE_PUBLIC_ACCESSIBILITY_EMAIL="accessibility@example.invalid"
VITE_PUBLIC_PRIVACY_EMAIL="privacy@example.invalid"
VITE_PUBLIC_OPERATOR_NAME="[Deployment Operator Name - Configure Before Production]"
VITE_PUBLIC_JURISDICTION="[Applicable Jurisdiction - Owner Review Required]"

# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER-ONLY CONFIGURATION (Vercel Serverless Functions ONLY)
# ------------------------------------------------------------------------------
# NEVER prefix these variables with `VITE_`.

# Firebase Admin SDK Credentials
# Option A: Full JSON service account string (recommended on Vercel as encrypted secret)
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=""
# Option B: Individual fields if not using JSON string
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Security & Verification Policy
# Comma-separated list of permitted browser Origins for mutation requests
ALLOWED_ORIGINS="http://localhost:5173,https://your-production-domain.vercel.app"
# Enforce Firebase App Check token verification on serverless write endpoints ("true" in production)
ENFORCE_APP_CHECK="true"
# Enforce verified email ownership before allowing journal mutations ("true" recommended)
REQUIRE_EMAIL_VERIFICATION="true"

# Persistent Rate Limiting (Upstash Redis)
# Required in production; server fails closed (503) if missing in production unless explicitly in local emulator test mode.
UPSTASH_REDIS_REST_URL="https://your-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX_PLACEHOLDER_UPSTASH_REDIS_REST_TOKEN"

# Configurable Rate Limit Thresholds (requests per 60-second sliding window)
RATE_LIMIT_CREATE_PER_MIN="12"
RATE_LIMIT_UPDATE_PER_MIN="20"
RATE_LIMIT_DELETE_PER_MIN="20"
RATE_LIMIT_ACCOUNT_DELETE_PER_HOUR="3"
RATE_LIMIT_IP_MUTATION_PER_MIN="30"
